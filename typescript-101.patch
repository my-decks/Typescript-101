+          </Code>
+        </div>
+        <div>
+          <Tag ts />
+          <Code file="greet.ts" lang="ts" size={15} style={{ marginTop: 10 }}>
+            <Kw>{"function "}</Kw><F>greet</F>{"(name: "}<Ty>string</Ty>{") {\n  "}<Kw>{"return "}</Kw><S>{'"Hi "'}</S>{" + name."}<F>toUpperCase</F>{"();\n}\n"}<F>greet</F>{"("}<span className="squig" style={{ backgroundColor: "rgba(244,71,71,.18)" }}><N>42</N></span>{");"}
